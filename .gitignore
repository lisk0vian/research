# =============================================================
# research — .gitignore
# =============================================================

# ---- Quarto ----
# Extensions are regenerated by `quarto add`, never committed
papers/*/paper/_extensions/
.quarto/
papers/*/paper/.quarto/
# Quarto's per-render sidecar folders (main_files/, main.knit.md, etc.)
papers/*/paper/*_files/
papers/*/paper/*.knit.md
papers/*/paper/*.rmarkdown

# ---- Build artifacts ----
# Everything under build/ is regenerable EXCEPT the final PDF, which we keep.
# NOTE: never ignore the build/ directory itself — if the dir is ignored, git
# won't even look at the !*.pdf exception inside it. Ignore the CONTENTS, then
# un-ignore the PDF and the .gitkeep.
papers/*/build/*
!papers/*/build/*.pdf
!papers/*/build/.gitkeep

# ---- LaTeX intermediates (from PDF rendering) ----
papers/*/paper/*.tex
papers/*/paper/*.aux
papers/*/paper/*.log
papers/*/paper/*.out
papers/*/paper/*.bbl
papers/*/paper/*.blg
papers/*/paper/*.bcf
papers/*/paper/*.run.xml
papers/*/paper/*.fls
papers/*/paper/*.fdb_latexmk
papers/*/paper/*.synctex.gz
papers/*/paper/*.toc
papers/*/paper/*.lof
papers/*/paper/*.lot
# but DO keep the source .qmd and .bib
!papers/*/paper/main.qmd
!papers/*/paper/references.bib
!papers/*/paper/references-source.bib

# ---- Data ----
# Raw data can be large / sensitive: ignore contents, keep the folder
papers/*/data/raw/*
!papers/*/data/raw/.gitkeep
# Processed data is regenerable from raw + code
papers/*/data/processed/*
!papers/*/data/processed/.gitkeep
# Common heavy data formats anywhere
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls
*.h5
*.hdf5
*.sqlite
*.db
# ...but keep small example/config CSVs if you explicitly force-add them
# (use: git add -f path/to/file.csv)

# ---- Machine learning artifacts ----
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.h5
wandb/
mlruns/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
# Python packaging dirs — anchored to repo ROOT only (leading /), so they do
# NOT match papers/*/build/ where we keep the final PDF.
/build/
/dist/

# ---- Jupyter notebooks ----
# Keep notebooks, but ignore checkpoint copies
papers/*/notebooks/.ipynb_checkpoints/

# ---- OpenCode / agent runtime ----
# Keep your commands, agents and skills; ignore local runtime/cache if any
.opencode/cache/
.opencode/logs/
.opencode/*.local.json

# ---- Secrets / credentials (never commit) ----
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.yaml
config.local.*

# ---- OS / editor ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
!.vscode/extensions.json
.idea/

# ---- Misc temp ----
*.tmp
*.bak
*.orig
tmp/
scratch/

# ---- Experiments in papers ----
papers/*/experiments/

# ---- Pipeline run logs (verbose, regenerable) ----
papers/*/outputs/logs/
