% references.bib — bibliography in CLASSIC BibTeX format (what Quarto/elsarticle use).
%
% IMPORTANT (see AGENTS.md):
% - This file is GENERATED from references-source.bib. Do not hand-edit if you
%   use a reference manager; edit the source and re-sync.
% - Zotero/Mendeley export biblatex (journaltitle, date). elsarticle needs
%   classic BibTeX (journal, year). The conversion script handles that.
%
% Expected entry format:
%
% @article{author_year_key,
%   title   = {Article title},
%   author  = {Last, First and Last2, First2},
%   journal = {Journal name},
%   volume  = {00},
%   number  = {0},
%   pages   = {000--000},
%   year    = {2024},
%   doi     = {10.xxxx/xxxxx},
% }
