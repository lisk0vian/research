# templates/journals/{{JOURNAL_SLUG}}/type.yaml
# Metadata for a target journal. Does NOT store the .cls unless the journal has
# no official Quarto extension (in that case, see raw-bundle/).

journal: "{{JOURNAL_NAME}}"
publisher: {{PUBLISHER}}                # elsevier | ieee | mdpi | springer | frontiers | ...
format: {{FORMAT}}                       # latex | word

# If the journal HAS an official Quarto extension, name it here and `quarto add`
# downloads it. If NOT, leave extension: "" and put the bundle in raw-bundle/.
extension: "{{QUARTO_EXTENSION}}"        # e.g. quarto-journals/elsevier

quarto_format: {{QUARTO_FORMAT}}         # e.g. elsevier-pdf
cite_style: {{CITE_STYLE}}               # number | authoryear | numbername
issn: "{{ISSN}}"

notes: >
  {{NOTES}}
